# Security and caching headers for Netlify / Cloudflare Pages.
# The Content-Security-Policy is also declared in each HTML file's <meta> tag, so
# GitHub Pages (which cannot send custom headers) gets the same protection.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'self'

# HTML: always revalidate so a new release is picked up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must never be cached, or updates stall.
/sw.js
  Cache-Control: no-cache

# Fingerprint-free asset names, so keep the window short.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/vendor/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800
